---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
    const blogEntries = await getCollection('blog');
    return blogEntries.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Build Your Business`} description={entry.data.description}>
    <article class="blog-post">
        <div class="container">
            <div class="back-link">
                <a href="/blog">&larr; Back to Blog</a>
            </div>
            
            <header class="post-header">
                <span class="category">{entry.data.category}</span>
                <h1>{entry.data.title}</h1>
                <div class="meta">
                    <time datetime={entry.data.pubDate.toISOString()}>
                        {entry.data.pubDate.toLocaleDateString('en-US', {
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric',
                        })}
                    </time>
                    <span class="author">By {entry.data.author}</span>
                </div>
            </header>
            
            <div class="content">
                <Content />
            </div>
            
            <footer class="post-footer">
                <div class="tags">
                    {entry.data.tags.map(tag => (
                        <span class="tag">#{tag}</span>
                    ))}
                </div>
            </footer>
        </div>
    </article>
</Layout>

<style>
    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 4rem 1rem;
    }
    .back-link {
        margin-bottom: 3rem;
    }
    .back-link a {
        color: #6b7280;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: color 0.2s;
    }
    .back-link a:hover {
        color: #111827;
    }
    .post-header {
        margin-bottom: 4rem;
        text-align: center;
    }
    .category {
        display: inline-block;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: 1rem;
        letter-spacing: 0.05em;
    }
    .post-header h1 {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1.2;
        color: #111827;
        margin: 0 0 1.5rem;
    }
    .meta {
        font-size: 1rem;
        color: #6b7280;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1.5rem;
    }
    .content {
        max-width: 740px;
        margin: 0 auto;
        font-size: 1.125rem;
        line-height: 1.8;
        color: #374151;
    }
    .content :global(h2) {
        font-size: 2rem;
        color: #111827;
        margin: 3rem 0 1.25rem;
        line-height: 1.3;
        font-weight: 700;
    }
    .content :global(h3) {
        font-size: 1.5rem;
        color: #111827;
        margin: 2.5rem 0 1rem;
        line-height: 1.4;
        font-weight: 600;
    }
    .content :global(p) {
        margin-bottom: 1.5rem;
    }
    .content :global(ul), .content :global(ol) {
        margin-bottom: 1.5rem;
        padding-left: 1.5rem;
    }
    .content :global(li) {
        margin-bottom: 0.5rem;
    }
    .content :global(blockquote) {
        border-left: 4px solid #e5e7eb;
        margin: 2rem 0;
        padding: 1.5rem 1.5rem 1.5rem 2rem;
        font-style: italic;
        color: #4b5563;
        background: #f9fafb;
        border-radius: 0 0.5rem 0.5rem 0;
    }
    .content :global(blockquote p:last-child) {
        margin-bottom: 0;
    }
    .content :global(a) {
        color: #2563eb;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .content :global(a:hover) {
        color: #1d4ed8;
    }
    .content :global(code) {
        background: #f3f4f6;
        padding: 0.2em 0.4em;
        border-radius: 0.25rem;
        font-size: 0.9em;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    .content :global(pre) {
        background: #111827;
        color: #f3f4f6;
        padding: 1.5rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        margin: 2rem 0;
    }
    .content :global(pre code) {
        background: transparent;
        padding: 0;
        color: inherit;
        font-size: 0.9em;
    }
    .content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 0.5rem;
        margin: 2rem 0;
        display: block;
    }
    .post-footer {
        max-width: 740px;
        margin: 4rem auto 0;
        padding-top: 2rem;
        border-top: 1px solid #eaeaea;
    }
    .tags {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .tag {
        font-size: 0.875rem;
        background: #f3f4f6;
        color: #4b5563;
        padding: 0.35rem 0.85rem;
        border-radius: 9999px;
        font-weight: 500;
    }
    
    @media (max-width: 768px) {
        .container {
            padding: 3rem 1.25rem;
        }
        .post-header {
            margin-bottom: 3rem;
        }
        .post-header h1 {
            font-size: 2.25rem;
        }
        .content :global(h2) {
            font-size: 1.75rem;
        }
        .content :global(h3) {
            font-size: 1.35rem;
        }
        .content :global(blockquote) {
            padding: 1.25rem;
            margin: 1.5rem 0;
        }
    }
</style>
