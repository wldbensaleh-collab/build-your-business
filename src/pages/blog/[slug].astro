---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
    const blogEntries = await getCollection('blog');
    return blogEntries.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description,
  "datePublished": entry.data.pubDate.toISOString(),
  "author": {
    "@type": "Person",
    "name": entry.data.author
  },
  "publisher": {
    "@type": "Organization",
    "name": "Build Your Business"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": new URL(Astro.url.pathname, Astro.site || Astro.url).toString()
  }
};
---

<Layout 
    title={`${entry.data.title} | Build Your Business`} 
    description={entry.data.description}
    ogType="article"
    articleMetadata={{
        publishedTime: entry.data.pubDate.toISOString(),
        author: entry.data.author,
        section: entry.data.category || 'Business'
    }}
    schema={JSON.stringify(articleSchema)}
>
    <article class="blog-post">
        
        <!-- ARTICLE HERO -->
        <header class="article-hero">
            <div class="article-container reveal">
                <div class="back-link">
                    <a href="/blog">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                        Back to Insights
                    </a>
                </div>
                
                <div class="hero-content">
                    <div class="meta-top">
                        <span class="category-badge">{entry.data.category || 'Business'}</span>
                        <span class="meta-divider">&bull;</span>
                        <time datetime={entry.data.pubDate.toISOString()}>
                            {entry.data.pubDate.toLocaleDateString('en-US', {
                                year: 'numeric',
                                month: 'long',
                                day: 'numeric',
                            })}
                        </time>
                    </div>
                    
                    <h1 class="title">{entry.data.title}</h1>
                    <p class="description">{entry.data.description}</p>
                    
                    <div class="author-block">
                        <div class="author-info">
                            <span class="author-label">Written by</span>
                            <span class="author-name">{entry.data.author}</span>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        
        <!-- ARTICLE CONTENT -->
        <div class="article-container main-content-container" style="transition-delay: 100ms;">
            <div class="article-content">
                <Content />
            </div>
        </div>
            
        <footer class="post-footer article-container">
            <div class="topics-section">
                <span class="topics-label">Related Topics</span>
                <div class="topics-list">
                    {entry.data.tags.map((tag: string) => (
                        <span class="topic-item">{tag}</span>
                    ))}
                </div>
            </div>
            
            <div class="continue-learning reveal">
                <span class="cl-eyebrow">KEEP BUILDING</span>
                <h2 class="cl-heading">Continue building your business</h2>
                <p class="cl-desc">Explore more practical guidance, systems, and strategies to help you grow.</p>
                <a href="/blog" class="cl-cta">
                    Browse All Articles
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </a>
            </div>
        </footer>
    </article>
</Layout>

<script>
    // Scroll reveal logic and table wrapping
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active');
            }
        });
    }, { threshold: 0.1 });
    
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // Automatically wrap Markdown tables, assign data-labels, and apply base class
    document.querySelectorAll('.article-content table').forEach(table => {
        if (!table.classList.contains('business-table')) {
            table.classList.add('business-table');
            const wrapper = document.createElement('div');
            wrapper.className = 'table-wrapper';
            table.parentNode?.insertBefore(wrapper, table);
            wrapper.appendChild(table);
            
            // Extract headers and assign data-label to each td
            const headers = Array.from(table.querySelectorAll('thead th')).map(th => th.textContent?.trim() || '');
            table.querySelectorAll('tbody tr').forEach(tr => {
                tr.querySelectorAll('td').forEach((td, i) => {
                    if (headers[i]) {
                        td.setAttribute('data-label', headers[i]);
                    }
                });
            });
        }
    });
    
    // Highlight rows containing strong elements
    document.querySelectorAll('.business-table tbody tr').forEach(tr => {
        const lastCell = tr.querySelector('td:last-child');
        if (lastCell && lastCell.querySelector('strong')) {
            tr.classList.add('important-row');
        }
    });
</script>

<style>
    .article-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 0 var(--space-4);
    }
    
    .article-hero {
        padding: var(--space-12) 0 var(--space-8);
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        background: #ffffff;
    }
    
    .back-link {
        margin-bottom: var(--space-8);
        max-width: 740px;
        margin-left: auto;
        margin-right: auto;
    }
    
    .back-link a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--color-text-light);
        font-weight: 600;
        font-size: 0.875rem;
        transition: color 0.2s ease, transform 0.2s ease;
        text-decoration: none;
    }
    
    .back-link a:hover {
        color: var(--color-brand-accent);
        transform: translateX(-2px);
    }
    
    .hero-content {
        display: flex;
        flex-direction: column;
        max-width: 740px;
        margin-left: auto;
        margin-right: auto;
    }
    
    .meta-top {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: var(--space-4);
        font-size: 0.875rem;
        color: var(--color-text-light);
        font-weight: 500;
    }
    
    .meta-divider {
        color: rgba(0, 0, 0, 0.15);
    }
    
    .category-badge {
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-brand-accent);
        letter-spacing: 0.05em;
        font-size: 0.75rem;
        background: rgba(0, 116, 217, 0.06);
        padding: 4px 12px;
        border-radius: 20px;
    }
    
    .title {
        font-size: clamp(2.25rem, 4vw, 3.25rem);
        line-height: 1.15;
        color: var(--color-brand-primary);
        margin-bottom: var(--space-4);
        letter-spacing: -0.02em;
        font-weight: 800;
    }
    
    .description {
        font-size: clamp(1.15rem, 2.5vw, 1.35rem);
        color: var(--color-text-muted);
        line-height: 1.6;
        margin-bottom: var(--space-6);
        font-weight: 400;
    }
    
    .author-block {
        display: flex;
        align-items: center;
        border-top: 1px solid rgba(0, 0, 0, 0.06);
        padding-top: var(--space-5);
        margin-top: var(--space-2);
    }
    
    .author-info {
        display: flex;
        flex-direction: column;
    }
    
    .author-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-text-light);
        font-weight: 600;
        margin-bottom: 2px;
    }
    
    .author-name {
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--color-brand-primary);
    }
    
    .main-content-container {
        padding-top: var(--space-12);
        padding-bottom: var(--space-12);
    }
    
    .article-content {
        font-size: 1.15rem;
        line-height: 1.8;
        color: #334155; /* highly readable dark slate */
    }
    
    .article-content > p,
    .article-content > ul,
    .article-content > ol,
    .article-content > blockquote,
    .article-content > h2,
    .article-content > h3,
    .article-content > h4,
    .article-content > hr,
    .article-content > .editorial-intro {
        max-width: 740px;
        margin-left: auto;
        margin-right: auto;
    }
    
    .article-content p {
        margin-bottom: var(--space-6);
    }
    
    .article-content h2 {
        font-size: clamp(1.75rem, 3vw, 2.25rem);
        color: var(--color-brand-primary);
        margin-top: var(--space-12);
        margin-bottom: var(--space-5);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.2;
    }
    
    .article-content h3 {
        font-size: clamp(1.35rem, 2vw, 1.65rem);
        color: var(--color-brand-primary);
        margin-top: var(--space-8);
        margin-bottom: var(--space-4);
        font-weight: 700;
        line-height: 1.3;
    }
    
    .article-content strong,
    .article-content b {
        font-weight: 600;
        color: var(--color-brand-primary);
    }
    
    .article-content a {
        color: var(--color-brand-accent);
        text-decoration: none;
        border-bottom: 1px solid rgba(0, 116, 217, 0.3);
        transition: border-color 0.2s ease, color 0.2s ease;
    }
    
    .article-content a:hover {
        color: var(--color-brand-primary);
        border-bottom-color: var(--color-brand-primary);
    }
    
    .article-content ul, .article-content ol {
        margin-bottom: var(--space-8);
        padding-left: var(--space-6);
    }
    
    .article-content li {
        margin-bottom: var(--space-3);
        line-height: 1.7;
    }
    
    .article-content li::marker {
        color: var(--color-brand-accent);
        font-weight: 600;
    }
    
    .article-content blockquote {
        margin: var(--space-8) auto;
        padding: var(--space-6);
        border-left: 4px solid var(--color-brand-accent);
        background: rgba(0, 116, 217, 0.04);
        font-style: normal;
        font-size: 1.15rem;
        color: var(--color-brand-primary);
        border-radius: 0 var(--radius-md) var(--radius-md) 0;
        box-shadow: var(--shadow-sm);
    }
    
    .article-content blockquote p {
        margin-bottom: var(--space-3);
    }
    
    .article-content blockquote p:last-child {
        margin-bottom: 0;
    }
    
    .article-content blockquote p:first-child strong:first-child {
        display: block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-brand-accent);
        margin-bottom: var(--space-3);
        font-weight: 700;
    }
    
    .post-footer {
        padding-top: var(--space-8);
        padding-bottom: var(--space-12);
    }
    
    .topics-section {
        border-top: 1px solid rgba(0, 0, 0, 0.08);
        padding-top: var(--space-8);
        margin-bottom: var(--space-12);
    }
    
    .topics-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: var(--space-4);
    }
    
    .topics-list {
        display: flex;
        gap: var(--space-3);
        flex-wrap: wrap;
    }
    
    .topic-item {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-brand-primary);
        background: var(--color-bg-alt);
        padding: 6px 14px;
        border-radius: 6px;
        transition: background 0.2s ease;
    }
    
    .topic-item:hover {
        background: rgba(0, 0, 0, 0.04);
    }
    
    .reveal {
        opacity: 0;
        transform: translateY(15px);
        transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }
    
    .continue-learning {
        background: var(--color-bg-alt);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 16px;
        padding: var(--space-8) var(--space-8);
        text-align: center;
    }
    
    .cl-eyebrow {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-brand-accent);
        margin-bottom: var(--space-3);
    }
    
    .cl-heading {
        font-size: 1.75rem;
        color: var(--color-brand-primary);
        font-weight: 800;
        margin-bottom: var(--space-3);
        letter-spacing: -0.02em;
    }
    
    .cl-desc {
        font-size: 1.1rem;
        color: var(--color-text-muted);
        margin-bottom: var(--space-6);
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }
    
    .cl-cta {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--color-brand-primary);
        color: #ffffff;
        font-weight: 600;
        padding: 12px 24px;
        border-radius: 8px;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    
    .cl-cta:hover {
        background: var(--color-brand-accent);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 116, 217, 0.2);
    }
    
    .cl-cta svg {
        transition: transform 0.2s ease;
    }
    
    .cl-cta:hover svg {
        transform: translateX(4px);
    }
    
    @media (max-width: 768px) {
        .article-hero {
            padding: var(--space-8) 0 var(--space-6);
        }
        
        .title {
            font-size: 2.25rem;
        }
        
        .description {
            font-size: 1.15rem;
        }
        
        .main-content-container {
            padding-top: var(--space-8);
        }
        
        .article-content {
            font-size: 1.05rem;
        }
        
        .continue-learning {
            padding: var(--space-6) var(--space-5);
        }
        
        .cl-heading {
            font-size: 1.5rem;
        }
    }
</style>
