---
import Layout from '../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
    return data.draft !== true;
});

const curatedSlugs = [
    'how-to-find-a-business-idea',
    'how-to-start-a-business-with-no-money',
    'how-to-validate-a-business-idea'
];

const curatedPosts = curatedSlugs
    .map(slug => allPosts.find(post => post.id === slug))
    .filter((post): post is CollectionEntry<'blog'> => post !== undefined);

const learningSteps = [
    { number: '01', phase: 'IDEATION', label: 'FIND AN IDEA' },
    { number: '02', phase: 'BOOTSTRAPPING', label: 'START LEAN' },
    { number: '03', phase: 'VALIDATION', label: 'VALIDATE IT' }
];

const pillars = [
    {
        number: '01',
        title: 'Business Fundamentals',
        description: 'Understand how businesses make money, select viable models, price offers, and build solid foundations.',
        href: '/guides',
        tag: 'FOUNDATION',
        outcome: 'Core Business Model',
        borderColor: 'var(--color-brand-primary)',
        icon: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>'
    },
    {
        number: '02',
        title: 'Starting a Business',
        description: 'Go from an initial idea to customer validation, your first offer, and your first paying customer.',
        href: '/guides',
        tag: 'VALIDATION',
        outcome: 'First Paying Customer',
        borderColor: 'var(--color-brand-accent)',
        icon: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 16 16 12 12 8"></polyline><line x1="8" y1="12" x2="16" y2="12"></line></svg>'
    },
    {
        number: '03',
        title: 'Making Money',
        description: 'Learn practical ways to earn through high-value skills, pricing, and recurring revenue streams.',
        href: '/blog',
        tag: 'REVENUE',
        outcome: 'Predictable Cash Flow',
        borderColor: 'var(--color-success)',
        icon: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>'
    },
    {
        number: '04',
        title: 'Business Management & Systems',
        description: 'Build reliable processes, automation, measurable workflows, and scalable operations.',
        href: '/guides',
        tag: 'OPERATIONS',
        outcome: 'Scalable Systems',
        borderColor: 'var(--color-brand-purple)',
        icon: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>'
    },
    {
        number: '05',
        title: 'Growing a Business',
        description: 'Learn modern marketing, sales, customer acquisition, retention, and sustainable scaling.',
        href: '/blog',
        tag: 'SCALING',
        outcome: 'Compounding Growth',
        borderColor: 'var(--color-warning)',
        icon: '<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>'
    }
];

const methodologySteps = [
    {
        number: '01',
        title: 'Learn',
        description: 'Understand the problem, market demand, and customer reality.',
        takeaway: 'Problem Discovery'
    },
    {
        number: '02',
        title: 'Build',
        description: 'Turn the insight into a testable offer or lean prototype in days.',
        takeaway: 'Rapid Prototyping'
    },
    {
        number: '03',
        title: 'Publish',
        description: 'Put the work directly in front of buyers to collect market evidence.',
        takeaway: 'Market Feedback'
    },
    {
        number: '04',
        title: 'Improve',
        description: 'Use quantitative results and buyer feedback to refine systems.',
        takeaway: 'System Optimization'
    }
];

const chapters = [
    { id: 'chapter-hero', label: 'Playbook', shortNum: '01' },
    { id: 'chapter-pillars', label: 'Pillars', shortNum: '02' },
    { id: 'chapter-guides', label: 'Roadmap', shortNum: '03' },
    { id: 'chapter-methodology', label: 'Methodology', shortNum: '04' },
    { id: 'chapter-cta', label: 'Launch', shortNum: '05' }
];
---

<Layout 
    title="Build Your Business | Start Lean, Grow Smart" 
    description="Practical guidance on building, managing, and growing a business using strategy, systems, technology, and practical execution."
>
    <div class="editorial-panorama-root" id="editorial-panorama-root">
        
        <!-- Pinned Sticky Viewport for Horizontal Canvas on Desktop -->
        <div class="panorama-viewport" id="panorama-viewport">
            
            <!-- Scroll-Reactive Atmospheric Background Layer -->
            <div class="panorama-atmosphere" id="panorama-atmosphere" aria-hidden="true">
                <div class="atmosphere-base"></div>
                <div class="atmosphere-glow"></div>
            </div>

            <!-- Continuous Horizontal Canvas Track -->
            <div class="panorama-canvas" id="panorama-canvas">
                
                <!-- ============================================================== -->
                <!-- CHAPTER 1: THE PLAYBOOK (HERO & BUSINESS SYSTEM)               -->
                <!-- ============================================================== -->
                <section class="chapter chapter-hero" id="chapter-hero" data-chapter="0">
                    <div class="hero-bg-glow"></div>
                    
                    <div class="chapter-content hero-layout">
                        <!-- Left Wing: Editorial Typographic Lead -->
                        <div class="hero-lead">
                            <div class="chapter-badge">
                                <span class="badge-index">01</span>
                                <span class="badge-text">THE ENTREPRENEUR'S PLAYBOOK</span>
                            </div>
                            <h1 class="hero-title">
                                Build smarter<br/>
                                <span class="text-gradient">Start lean</span><br/>
                                Grow a real business
                            </h1>
                            <p class="hero-desc">
                                Cut through the noise. Get practical guidance on building, managing, and growing a profitable business through systems, execution, and strategy.
                            </p>
                            <div class="hero-cta-group">
                                <a href="/blog" class="btn btn-primary">Start Here</a>
                                <a href="/guides" class="btn btn-outline">Explore Guides</a>
                            </div>
                            
                            <div class="hero-scroll-hint" aria-hidden="true">
                                <span class="hint-arrow">&rarr;</span>
                                <span class="hint-text">Scroll to explore the playbook</span>
                            </div>
                        </div>

                        <!-- Right Wing: Chapter 01 Hero Sculpture Visual -->
                        <div class="hero-visual-card">
                            <div class="hero-sculpture-stage" id="hero-sculpture-stage">
                                <canvas 
                                    class="hero-sculpture-canvas" 
                                    id="hero-sculpture-canvas"
                                    aria-label="Build Your Business assembling sapphire glass sculpture"
                                ></canvas>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============================================================== -->
                <!-- CHAPTER 2: THE 5 PILLARS (CONSISTENT COMPONENT SYSTEM)         -->
                <!-- ============================================================== -->
                <section class="chapter chapter-pillars" id="chapter-pillars" data-chapter="1">
                    
                    <div class="chapter-content pillars-layout">
                        <!-- Chapter Intro Header -->
                        <div class="section-header-centered">
                            <div class="chapter-badge">
                                <span class="badge-index">02</span>
                                <span class="badge-text">CORE DISCIPLINES</span>
                            </div>
                            <h2 class="chapter-heading">Everything you need to build a real business</h2>
                            <p class="chapter-summary">
                                Five interconnected pillars designed for pragmatic founders—from initial validation to sustainable operations.
                            </p>
                        </div>

                        <!-- 5 Pillar Cards in One Unified Component Family -->
                        <div class="pillars-grid">
                            {pillars.map((pillar) => (
                                <a 
                                    href={pillar.href} 
                                    class="card pillar-card"
                                    style={`--pillar-accent: ${pillar.borderColor};`}
                                    aria-label={`Explore ${pillar.title}`}
                                >
                                    <div class="pillar-card-header">
                                        <div class="pillar-card-meta">
                                            <span class="pillar-num">{pillar.number}</span>
                                            <span class="pillar-tag">{pillar.tag}</span>
                                        </div>
                                        <div class="pillar-icon" set:html={pillar.icon} />
                                    </div>
                                    <h3 class="pillar-title">{pillar.title}</h3>
                                    <p class="pillar-desc">{pillar.description}</p>
                                    <div class="pillar-outcome">
                                        <span class="outcome-label">TARGET:</span>
                                        <span class="outcome-val">{pillar.outcome}</span>
                                    </div>
                                    <div class="pillar-footer">
                                        <span class="pillar-link-text">Explore Guides</span>
                                        <span class="pillar-arrow">&rarr;</span>
                                    </div>
                                </a>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- ============================================================== -->
                <!-- CHAPTER 3: GUIDED ROADMAPS (STRUCTURED DOSSIER LAYOUT)         -->
                <!-- ============================================================== -->
                <section class="chapter chapter-guides" id="chapter-guides" data-chapter="2">

                    <div class="chapter-content guides-layout">
                        <!-- Left: Chapter Header -->
                        <div class="chapter-header-box">
                            <div class="chapter-badge">
                                <span class="badge-index">03</span>
                                <span class="badge-text">STEP-BY-STEP PATH</span>
                            </div>
                            <h2 class="chapter-heading">Start Building Your Business</h2>
                            <p class="chapter-summary">
                                Practical, sequential guides to take you from a raw concept to an offer you can test with real customers.
                            </p>
                            <div class="guides-direct-link">
                                <a href="/blog" class="btn btn-outline">View All Articles &rarr;</a>
                            </div>
                        </div>

                        <!-- Right: 3 Sequential Dossier Cards -->
                        <div class="guides-dossier-track">
                            {curatedPosts.map((post, index) => (
                                <article class="card guide-dossier-card">
                                    <div class="dossier-step-header">
                                        <span class="dossier-num">{learningSteps[index]?.number}</span>
                                        <span class="dossier-phase">&mdash; {learningSteps[index]?.label}</span>
                                    </div>
                                    <div class="dossier-body">
                                        <span class="category-badge">{post.data.category}</span>
                                        <h3 class="dossier-title">
                                            <a href={`/blog/${post.id}`}>{post.data.title}</a>
                                        </h3>
                                        <p class="dossier-description">{post.data.description}</p>
                                    </div>
                                    <div class="dossier-footer">
                                        <a href={`/blog/${post.id}`} class="dossier-action-link">
                                            <span>Read Guide</span>
                                            <span class="action-arrow">&rarr;</span>
                                        </a>
                                    </div>
                                </article>
                            ))}
                        </div>
                    </div>
                </section>

                <!-- ============================================================== -->
                <!-- CHAPTER 4: THE EXECUTION RHYTHM (METHODOLOGY SYSTEM)          -->
                <!-- ============================================================== -->
                <section class="chapter chapter-methodology" id="chapter-methodology" data-chapter="3">

                    <div class="chapter-content methodology-layout">
                        <!-- Chapter Intro Header -->
                        <div class="section-header-centered">
                            <div class="chapter-badge">
                                <span class="badge-index">04</span>
                                <span class="badge-text">EXECUTION ENGINE</span>
                            </div>
                            <h2 class="chapter-heading">Learn. Build. Publish. Improve.</h2>
                            <p class="chapter-summary">
                                A continuous operating rhythm for turning knowledge into testable products and measurable momentum.
                            </p>
                        </div>

                        <!-- 4 Methodological Nodes in One Unified Row -->
                        <div class="methodology-track-wrapper">
                            <div class="methodology-connecting-line" aria-hidden="true"></div>
                            
                            <div class="methodology-nodes-grid">
                                {methodologySteps.map((step) => (
                                    <div class="methodology-node-card">
                                        <div class="node-top">
                                            <div class="node-num">{step.number}</div>
                                            <span class="node-tag">{step.takeaway}</span>
                                        </div>
                                        <h3 class="node-title">{step.title}</h3>
                                        <p class="node-desc">{step.description}</p>
                                    </div>
                                ))}
                            </div>
                            
                            <!-- Closed Loop Repeat Indicator -->
                            <div class="cycle-return-banner" aria-hidden="true">
                                <span class="return-icon">&#x21bb;</span>
                                <span class="return-text">Continuous Feedback: Real-world results from Step 04 inform Step 01</span>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============================================================== -->
                <!-- CHAPTER 5: THE LAUNCHPAD (EDGE-TO-EDGE DESTINATION CANVAS)    -->
                <!-- ============================================================== -->
                <section class="chapter chapter-cta" id="chapter-cta" data-chapter="4">

                    <div class="chapter-content cta-layout">
                        <div class="cta-inner-card">
                            <div class="chapter-badge badge-dark">
                                <span class="badge-index">05</span>
                                <span class="badge-text">LAUNCHPAD</span>
                            </div>
                            <h2 class="cta-main-title">Ready to Start Building?</h2>
                            <p class="cta-main-desc">
                                Cut through the noise. Get actionable strategy, systems, and execution frameworks to build a profitable, sustainable business.
                            </p>
                            <div class="cta-action-wrap">
                                <a href="/blog" class="btn btn-accent btn-large">Start Exploring</a>
                                <a href="/guides" class="btn btn-dark-outline">Read Core Guides</a>
                            </div>

                            <!-- Integrated Quick Directory -->
                            <div class="cta-directory">
                                <div class="directory-title">DIRECTORY</div>
                                <div class="directory-links">
                                    <a href="/blog">All Articles</a>
                                    <span class="dir-dot">&bull;</span>
                                    <a href="/guides">Structured Guides</a>
                                    <span class="dir-dot">&bull;</span>
                                    <a href="/resources">Tools & Resources</a>
                                    <span class="dir-dot">&bull;</span>
                                    <a href="/about">About BYB</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

            </div>

            <!-- ============================================================== -->
            <!-- FLOATING EDITORIAL TIMELINE DOCK (DESKTOP INTERACTIVE CONTROL)  -->
            <!-- ============================================================== -->
            <nav class="editorial-dock" id="editorial-dock" aria-label="Editorial Panorama Navigation">
                <div class="dock-container">
                    <div class="dock-progress-rail">
                        <div class="dock-progress-indicator" id="dock-progress-indicator"></div>
                    </div>
                    <ul class="dock-chapters-list">
                        {chapters.map((chap, idx) => (
                            <li>
                                <button 
                                    type="button" 
                                    class={`dock-chapter-btn ${idx === 0 ? 'active' : ''}`}
                                    data-chapter-index={idx}
                                    data-chapter-id={chap.id}
                                    aria-label={`Jump to Chapter ${chap.shortNum}: ${chap.label}`}
                                >
                                    <span class="dock-chap-num">{chap.shortNum}</span>
                                    <span class="dock-chap-label">{chap.label}</span>
                                </button>
                            </li>
                        ))}
                    </ul>
                </div>
            </nav>

        </div>
    </div>
</Layout>

<script>
    // =========================================================================
    // EDITORIAL HORIZONTAL PANORAMA INTERACTION SCRIPT
    // =========================================================================

    function initEditorialPanorama(
        root: HTMLElement,
        viewport: HTMLElement,
        canvas: HTMLElement
    ): void {
        const chapters = Array.from(document.querySelectorAll<HTMLElement>('.chapter'));
        if (chapters.length === 0) return;

        const chapterHero = document.getElementById('chapter-hero') as HTMLElement | null;
        const sculptureCanvas = document.getElementById('hero-sculpture-canvas') as HTMLCanvasElement | null;
        const sculptureStage = document.getElementById('hero-sculpture-stage') as HTMLElement | null;
        const atmosphereEl = document.getElementById('panorama-atmosphere') as HTMLElement | null;

        const dock = document.getElementById('editorial-dock');
        const progressBar = document.getElementById('dock-progress-indicator');
        const dockButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.dock-chapter-btn'));

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const MOBILE_BREAKPOINT = 768;

        function isPanoramaActive(): boolean {
            return window.innerWidth >= MOBILE_BREAKPOINT && !prefersReducedMotion.matches;
        }

        // =====================================================================
        // CHAPTER 01 HERO SCULPTURE FRAME ANIMATION (96 WEBP FRAMES)
        // =====================================================================
        const TOTAL_FRAMES = 96;
        const rawFrames: (HTMLImageElement | null)[] = new Array(TOTAL_FRAMES).fill(null);
        const processedCanvases: (HTMLCanvasElement | null)[] = new Array(TOTAL_FRAMES).fill(null);
        let lastRenderedFrameIndex = -1;
        let currentRequestedIndex = 0;

        // Process source WebP frame into an offscreen canvas with true RGBA transparency:
        // - Crops unwanted outer margins and side border artifacts
        // - High-confidence core segmentation preserves genuine sapphire glass, facets, and highlights
        // - Connected component analysis isolates and discards the disconnected studio-floor artifact
        // - Very narrow 1-2px edge transition eliminates soft gray/white halos without artificial de-matting
        // - Preserves 100% of authentic glass colors, deep refractions, and frosted highlight gradients
        function processFrameToCanvas(img: HTMLImageElement): HTMLCanvasElement {
            const offscreen = document.createElement('canvas');
            const CROP_X = 18;
            const CROP_Y = 80;
            const CROP_W = 684;
            const CROP_H = 1100;

            offscreen.width = CROP_W;
            offscreen.height = CROP_H;
            const offCtx = offscreen.getContext('2d', { willReadFrequently: true });
            if (!offCtx) return offscreen;

            offCtx.drawImage(img, CROP_X, CROP_Y, CROP_W, CROP_H, 0, 0, CROP_W, CROP_H);
            const imgData = offCtx.getImageData(0, 0, CROP_W, CROP_H);
            const d = imgData.data;
            const totalPixels = CROP_W * CROP_H;
            const width = CROP_W;

            const coreConf = new Float32Array(totalPixels);
            const richSapphire = new Uint8Array(totalPixels);

            // PASS 1: Identify high-confidence core glass and rich sapphire features
            for (let i = 0; i < totalPixels; i++) {
                const dataIdx = i << 2;
                const r = d[dataIdx];
                const g = d[dataIdx + 1];
                const b = d[dataIdx + 2];

                // Immediate bypass for pure/near-pure neutral white studio background
                if (r >= 250 && g >= 250 && b >= 250) continue;

                const y = Math.floor(i / width);
                const maxRG = r > g ? r : g;
                const blueDom = b - maxRG;
                const maxRGB = maxRG > b ? maxRG : b;
                const minRGB = r < g ? (r < b ? r : b) : (g < b ? g : b);
                const chroma = maxRGB - minRGB;
                const brightness = (r * 299 + g * 587 + b * 114) / 1000;
                const sat = maxRGB > 0 ? chroma / maxRGB : 0;

                const dr = 255 - r;
                const dg = 255 - g;
                const db = 255 - b;
                const distWhite = Math.sqrt(dr * dr + dg * dg + db * db);

                if (distWhite < 25) continue;

                // Mark rich sapphire / dark facet pixels for component authentication
                if ((sat >= 0.20 && blueDom >= 25) || (brightness < 165 && blueDom > 4)) {
                    richSapphire[i] = 1;
                }

                // Studio floor shadow filter in lower quadrant (y > 720)
                const isDarkStructure = brightness < 185 && blueDom > 3;
                if (y > 720 && (sat < 0.14 || blueDom < 25) && minRGB > 185 && !isDarkStructure) {
                    continue;
                }

                // 1. Dark refractions & structural facet lines
                let darkGlassConf = 0;
                if (isDarkStructure) {
                    const bf = (185 - brightness) / 30;
                    const bdf = (blueDom - 3) / 6;
                    darkGlassConf = (bf > 1 ? 1 : bf) * (bdf > 1 ? 1 : bdf);
                }

                // 2. Saturated sapphire glass body
                let satConf = 0;
                if (sat >= 0.18 && blueDom >= 14) {
                    const sf = (sat - 0.18) / 0.12;
                    const bdf = (blueDom - 14) / 10;
                    satConf = (sf > 1 ? 1 : sf) * (bdf > 1 ? 1 : bdf);
                }

                // 3. Blue dominance core & internal highlights
                let bdomConf = 0;
                if (blueDom >= 24 && distWhite >= 30) {
                    const bdf = (blueDom - 24) / 12;
                    const dwf = (distWhite - 30) / 20;
                    bdomConf = (bdf > 1 ? 1 : bdf) * (dwf > 1 ? 1 : dwf);
                }

                let conf = darkGlassConf;
                if (satConf > conf) conf = satConf;
                if (bdomConf > conf) conf = bdomConf;

                coreConf[i] = conf;
            }

            // PASS 2: Connected Component Analysis on candidate core regions (Union-Find)
            // Allows all 4 cubes to remain independent connected components, while isolating
            // and discarding small, low-chroma studio-floor artifacts and noise specks.
            const labels = new Int32Array(totalPixels);
            const parent = [0];
            let nextLabel = 1;

            function findRoot(node: number): number {
                let root = node;
                while (root !== parent[root]) root = parent[root];
                let curr = node;
                while (curr !== root) {
                    const nxt = parent[curr];
                    parent[curr] = root;
                    curr = nxt;
                }
                return root;
            }

            function unionLabels(a: number, b: number): void {
                const rootA = findRoot(a);
                const rootB = findRoot(b);
                if (rootA !== rootB) {
                    if (rootA < rootB) parent[rootB] = rootA;
                    else parent[rootA] = rootB;
                }
            }

            for (let y = 0; y < CROP_H; y++) {
                const rowOffset = y * width;
                for (let x = 0; x < width; x++) {
                    const idx = rowOffset + x;
                    if (coreConf[idx] <= 0.10) continue;

                    const left = x > 0 && coreConf[idx - 1] > 0.10 ? labels[idx - 1] : 0;
                    const up = y > 0 && coreConf[idx - width] > 0.10 ? labels[idx - width] : 0;

                    if (left === 0 && up === 0) {
                        labels[idx] = nextLabel;
                        parent.push(nextLabel);
                        nextLabel++;
                    } else if (left !== 0 && up === 0) {
                        labels[idx] = left;
                    } else if (left === 0 && up !== 0) {
                        labels[idx] = up;
                    } else {
                        labels[idx] = left;
                        if (left !== up) unionLabels(left, up);
                    }
                }
            }

            // Accumulate pixel area and rich sapphire pixel counts per component root
            const compArea = new Int32Array(nextLabel);
            const compSapphire = new Int32Array(nextLabel);

            for (let i = 0; i < totalPixels; i++) {
                if (labels[i] !== 0) {
                    const root = findRoot(labels[i]);
                    labels[i] = root;
                    compArea[root]++;
                    if (richSapphire[i] === 1) compSapphire[root]++;
                }
            }

            // Keep components that contain substantial sapphire glass (genuine cubes have >= 45,000 px)
            // Discard small disconnected studio floor residue (area < 8000 or sapphire < 2000)
            const validRoot = new Uint8Array(nextLabel);
            for (let l = 1; l < nextLabel; l++) {
                if (parent[l] === l) {
                    if (compArea[l] >= 8000 && compSapphire[l] >= 2000) {
                        validRoot[l] = 1;
                    }
                }
            }

            const validCore = new Uint8Array(totalPixels);
            for (let i = 0; i < totalPixels; i++) {
                const l = labels[i];
                if (l !== 0 && validRoot[l] === 1) {
                    validCore[i] = 1;
                }
            }

            // PASS 3: Clean Core & Narrow 1-2px Edge Mask Construction
            // Avoids artificial white-subtractive de-matting math to preserve clean authentic sapphire color
            for (let i = 0; i < totalPixels; i++) {
                const dataIdx = i << 2;

                if (validCore[i] === 1) {
                    const conf = coreConf[i];
                    if (conf >= 0.85) {
                        d[dataIdx + 3] = 255;
                    } else if (conf <= 0.05) {
                        d[dataIdx + 3] = 0;
                    } else {
                        const alphaFloat = conf * conf * (3 - 2 * conf);
                        d[dataIdx + 3] = Math.round(alphaFloat * 255);
                    }
                } else {
                    // Check narrow 1-2px edge neighbor adjacency to valid core
                    const x = i % width;
                    const y = Math.floor(i / width);
                    const isEdgeNeighbor =
                        (x > 0 && validCore[i - 1] === 1) ||
                        (x < width - 1 && validCore[i + 1] === 1) ||
                        (y > 0 && validCore[i - width] === 1) ||
                        (y < CROP_H - 1 && validCore[i + width] === 1);

                    if (isEdgeNeighbor) {
                        const r = d[dataIdx];
                        const g = d[dataIdx + 1];
                        const b = d[dataIdx + 2];
                        const maxRG = r > g ? r : g;
                        const blueDom = b - maxRG;
                        const maxRGB = maxRG > b ? maxRG : b;
                        const minRGB = r < g ? (r < b ? r : b) : (g < b ? g : b);
                        const chroma = maxRGB - minRGB;
                        const sat = maxRGB > 0 ? chroma / maxRGB : 0;
                        const dr = 255 - r;
                        const dg = 255 - g;
                        const db = 255 - b;
                        const distWhite = Math.sqrt(dr * dr + dg * dg + db * db);

                        const isNeutralBg = distWhite < 25 || (minRGB > 210 && sat < 0.10) || blueDom < 6;
                        if (!isNeutralBg) {
                            const satFactor = Math.min(1, Math.max(0, (sat - 0.06) / 0.18));
                            const bdomFactor = Math.min(1, Math.max(0, (blueDom - 6) / 16));
                            const whiteFactor = Math.min(1, Math.max(0, (distWhite - 22) / 30));
                            const edgeRaw = satFactor * bdomFactor * whiteFactor;
                            const edgeSmooth = edgeRaw * edgeRaw * (3 - 2 * edgeRaw);
                            d[dataIdx + 3] = Math.round(edgeSmooth * 255);
                        } else {
                            d[dataIdx + 3] = 0;
                        }
                    } else {
                        d[dataIdx + 3] = 0;
                    }
                }
            }

            offCtx.putImageData(imgData, 0, 0);
            return offscreen;
        }

        function loadFrame(index: number, onLoaded?: () => void): void {
            if (index < 0 || index >= TOTAL_FRAMES || rawFrames[index]) return;
            const img = new Image();
            rawFrames[index] = img;
            img.onload = () => {
                // Process once when loaded and cache the transparent canvas
                processedCanvases[index] = processFrameToCanvas(img);
                if (onLoaded) onLoaded();
            };
            img.src = `/hero/frames/frame-${String(index + 1).padStart(4, '0')}.webp`;
        }

        function getNearestLoadedCanvas(targetIndex: number): HTMLCanvasElement | null {
            if (processedCanvases[targetIndex]) {
                return processedCanvases[targetIndex];
            }
            for (let offset = 1; offset < TOTAL_FRAMES; offset++) {
                const down = targetIndex - offset;
                if (down >= 0 && processedCanvases[down]) {
                    return processedCanvases[down];
                }
                const up = targetIndex + offset;
                if (up < TOTAL_FRAMES && processedCanvases[up]) {
                    return processedCanvases[up];
                }
            }
            return null;
        }

        function renderSculpture(targetIndex: number, forceRedraw = false): void {
            if (!sculptureCanvas || !sculptureStage) return;
            const ctx = sculptureCanvas.getContext('2d');
            if (!ctx) return;

            currentRequestedIndex = targetIndex;

            if (!rawFrames[targetIndex]) {
                loadFrame(targetIndex, () => {
                    if (currentRequestedIndex === targetIndex) {
                        renderSculpture(targetIndex);
                    }
                });
            }

            const cachedCanvas = getNearestLoadedCanvas(targetIndex);
            if (!cachedCanvas) return;

            if (!forceRedraw && lastRenderedFrameIndex === targetIndex && cachedCanvas === processedCanvases[targetIndex]) {
                return;
            }

            const rect = sculptureStage.getBoundingClientRect();
            const displayWidth = Math.max(1, Math.round(rect.width));
            const displayHeight = Math.max(1, Math.round(rect.height));
            const dpr = Math.min(window.devicePixelRatio || 1, 2);
            const targetBufferWidth = Math.round(displayWidth * dpr);
            const targetBufferHeight = Math.round(displayHeight * dpr);

            if (sculptureCanvas.width !== targetBufferWidth || sculptureCanvas.height !== targetBufferHeight) {
                sculptureCanvas.width = targetBufferWidth;
                sculptureCanvas.height = targetBufferHeight;
            }

            ctx.imageSmoothingEnabled = true;
            ctx.imageSmoothingQuality = 'high';

            const sWidth = cachedCanvas.width;
            const sHeight = cachedCanvas.height;
            const cropAspect = sWidth / sHeight;

            // Target 80% to 85% of available stage height for a commanding, floating 3D presence
            let drawH = Math.round(sculptureCanvas.height * 0.82);
            let drawW = Math.round(drawH * cropAspect);

            // Ensure ample breathing room horizontally with no clipping
            if (drawW > sculptureCanvas.width * 0.88) {
                drawW = Math.round(sculptureCanvas.width * 0.88);
                drawH = Math.round(drawW / cropAspect);
            }

            const drawX = Math.round((sculptureCanvas.width - drawW) / 2);
            const drawY = Math.round((sculptureCanvas.height - drawH) / 2);

            ctx.clearRect(0, 0, sculptureCanvas.width, sculptureCanvas.height);
            ctx.drawImage(cachedCanvas, drawX, drawY, drawW, drawH);

            if (cachedCanvas === processedCanvases[targetIndex]) {
                lastRenderedFrameIndex = targetIndex;
            }
        }

        function preloadAllFrames(): void {
            const isDesktopMotion = isPanoramaActive();
            const primaryIndex = isDesktopMotion ? 0 : TOTAL_FRAMES - 1;

            // 1. Priority: Load the primary frame immediately
            loadFrame(primaryIndex, () => {
                renderSculpture(primaryIndex, true);
            });

            // 2. Also load the opposite boundary early
            const secondaryIndex = isDesktopMotion ? TOTAL_FRAMES - 1 : 0;
            loadFrame(secondaryIndex, () => {
                if (currentRequestedIndex === secondaryIndex) {
                    renderSculpture(secondaryIndex);
                }
            });

            // 3. Incrementally preload all remaining frames asynchronously
            let nextIndex = 0;
            function loadBatch(): void {
                let count = 0;
                while (nextIndex < TOTAL_FRAMES && count < 4) {
                    const idx = nextIndex++;
                    if (idx !== primaryIndex && idx !== secondaryIndex) {
                        loadFrame(idx, () => {
                            if (Math.abs(currentRequestedIndex - idx) <= 1) {
                                renderSculpture(currentRequestedIndex);
                            }
                        });
                        count++;
                    }
                }
                if (nextIndex < TOTAL_FRAMES) {
                    if (typeof window !== 'undefined' && 'requestIdleCallback' in window) {
                        (window as any).requestIdleCallback(loadBatch, { timeout: 150 });
                    } else {
                        setTimeout(loadBatch, 25);
                    }
                }
            }

            if (typeof window !== 'undefined' && 'requestIdleCallback' in window) {
                (window as any).requestIdleCallback(loadBatch, { timeout: 150 });
            } else {
                setTimeout(loadBatch, 25);
            }
        }

        // =====================================================================
        // SCROLL-REACTIVE ATMOSPHERIC BACKGROUND SYSTEM
        // Progression: Midnight Navy -> Deep Cobalt -> Muted Blue -> Pale Blue -> Editorial Cream
        // =====================================================================
        interface AtmosphereStop {
            progress: number;
            r: number;
            g: number;
            b: number;
            glowR: number;
            glowG: number;
            glowB: number;
            glowA: number;
            secA: number;
        }

        const ATMOSPHERE_STOPS: AtmosphereStop[] = [
            // Stop 01 (progress 0.00): Midnight Navy (#071A33) with Cobalt & Sapphire atmosphere
            { progress: 0.00, r: 7,   g: 26,  b: 51,  glowR: 0,   glowG: 116, glowB: 217, glowA: 0.20, secA: 0.09 },
            // Stop 02 (progress 0.25): Deep Cobalt (#101F38)
            { progress: 0.25, r: 16,  g: 31,  b: 56,  glowR: 59,  glowG: 130, glowB: 246, glowA: 0.14, secA: 0.06 },
            // Stop 03 (progress 0.50): Muted Blue (#2C4868)
            { progress: 0.50, r: 44,  g: 72,  b: 104, glowR: 96,  glowG: 165, glowB: 250, glowA: 0.12, secA: 0.03 },
            // Stop 04 (progress 0.75): Pale Blue (#E2ECF7)
            { progress: 0.75, r: 226, g: 236, b: 247, glowR: 255, glowG: 255, glowB: 255, glowA: 0.55, secA: 0.00 },
            // Stop 05 (progress 1.00): Editorial Cream (#FBF9F4)
            { progress: 1.00, r: 251, g: 249, b: 244, glowR: 255, glowG: 255, glowB: 255, glowA: 0.70, secA: 0.00 }
        ];

        function updateAtmosphere(progress: number): void {
            if (!atmosphereEl) return;
            const p = Math.max(0, Math.min(1, progress));

            let s0 = ATMOSPHERE_STOPS[0];
            let s1 = ATMOSPHERE_STOPS[ATMOSPHERE_STOPS.length - 1];

            for (let i = 0; i < ATMOSPHERE_STOPS.length - 1; i++) {
                if (p >= ATMOSPHERE_STOPS[i].progress && p <= ATMOSPHERE_STOPS[i + 1].progress) {
                    s0 = ATMOSPHERE_STOPS[i];
                    s1 = ATMOSPHERE_STOPS[i + 1];
                    break;
                }
            }

            const range = s1.progress - s0.progress;
            const rawT = range > 0 ? (p - s0.progress) / range : 0;
            // Hermite smoothstep for smooth organic interpolation across chapter transitions
            const t = rawT * rawT * (3 - 2 * rawT);

            const r = Math.round(s0.r + (s1.r - s0.r) * t);
            const g = Math.round(s0.g + (s1.g - s0.g) * t);
            const b = Math.round(s0.b + (s1.b - s0.b) * t);

            const gr = Math.round(s0.glowR + (s1.glowR - s0.glowR) * t);
            const gg = Math.round(s0.glowG + (s1.glowG - s0.glowG) * t);
            const gb = Math.round(s0.glowB + (s1.glowB - s0.glowB) * t);
            const ga = (s0.glowA + (s1.glowA - s0.glowA) * t).toFixed(3);
            const sa = (s0.secA + (s1.secA - s0.secA) * t).toFixed(3);

            const glowX = (40 + p * 20).toFixed(1);
            const glowY = (28 + p * 12).toFixed(1);

            atmosphereEl.style.setProperty('--atmosphere-bg', `rgb(${r}, ${g}, ${b})`);
            atmosphereEl.style.setProperty('--glow-color', `rgba(${gr}, ${gg}, ${gb}, ${ga})`);
            atmosphereEl.style.setProperty('--secondary-glow', `rgba(93, 169, 255, ${sa})`);
            atmosphereEl.style.setProperty('--glow-x', `${glowX}%`);
            atmosphereEl.style.setProperty('--glow-y', `${glowY}%`);
        }

        // Exact canvas travel calculated from the last chapter's offset
        function getCanvasTravel(): number {
            const lastChapter = chapters[chapters.length - 1];
            return lastChapter ? lastChapter.offsetLeft : (chapters.length - 1) * viewport.clientWidth;
        }

        function calculateDimensions(): void {
            if (!isPanoramaActive()) {
                root.style.height = '';
                canvas.style.transform = '';
                if (dock) dock.classList.remove('dock-hidden');
                renderSculpture(TOTAL_FRAMES - 1, true);
                return;
            }

            const chapterWidth = viewport.clientWidth;
            root.style.setProperty('--chapter-width', `${chapterWidth}px`);

            // Exactly 1 viewport of vertical scroll runway per chapter transition
            const totalRunway = (chapters.length - 1) * window.innerHeight;
            root.style.height = `${window.innerHeight + totalRunway}px`;

            renderSculpture(currentRequestedIndex, true);
        }

        let ticking = false;

        function updateScroll(): void {
            if (!isPanoramaActive()) {
                renderSculpture(TOTAL_FRAMES - 1);
                return;
            }

            const rect = root.getBoundingClientRect();
            const maxScroll = root.offsetHeight - window.innerHeight;
            if (maxScroll <= 0) return;

            // Progress from 0.0 (entry) to 1.0 (terminal chapter)
            const scrolled = -rect.top;
            const progress = Math.max(0, Math.min(1, scrolled / maxScroll));

            // Smooth horizontal translation tied 1:1 to viewport width
            const totalTravel = getCanvasTravel();
            const currentTranslate = progress * totalTravel;
            canvas.style.transform = `translate3d(-${currentTranslate.toFixed(2)}px, 0, 0)`;

            // Update scroll-reactive atmospheric background
            updateAtmosphere(progress);

            // Hero-local progress calculation from actual geometry
            const heroStart = chapterHero ? chapterHero.offsetLeft : 0;
            const heroEnd = chapterHero ? heroStart + chapterHero.offsetWidth : viewport.clientWidth;
            const heroTravel = heroEnd - heroStart;
            const heroProgress = heroTravel > 0
                ? Math.max(0, Math.min(1, (currentTranslate - heroStart) / heroTravel))
                : 0;

            const frameIndex = Math.max(0, Math.min(TOTAL_FRAMES - 1, Math.round(heroProgress * (TOTAL_FRAMES - 1))));
            renderSculpture(frameIndex);

            // Update bottom dock progress bar
            if (progressBar) {
                progressBar.style.width = `${(progress * 100).toFixed(1)}%`;
            }

            // Determine active chapter based on normalized progress
            const activeIdx = Math.min(
                chapters.length - 1,
                Math.max(0, Math.round(progress * (chapters.length - 1)))
            );

            dockButtons.forEach((btn, idx) => {
                const isActive = idx === activeIdx;
                btn.classList.toggle('active', isActive);
                btn.setAttribute('aria-current', isActive ? 'true' : 'false');
            });

            // Seamlessly hide dock when exiting into the footer
            if (dock) {
                const isEnteringFooter = rect.bottom <= window.innerHeight + 20;
                dock.classList.toggle('dock-hidden', isEnteringFooter);
            }
        }

        function onScroll(): void {
            if (!ticking) {
                requestAnimationFrame(() => {
                    updateScroll();
                    ticking = false;
                });
                ticking = true;
            }
        }

        function scrollToChapter(index: number): void {
            if (!isPanoramaActive() || !chapters[index]) return;

            const targetProgress = index / (chapters.length - 1);
            const maxScroll = root.offsetHeight - window.innerHeight;
            const targetScroll = targetProgress * maxScroll;

            window.scrollTo({
                top: targetScroll,
                behavior: 'smooth'
            });
        }

        // Click on dock buttons
        dockButtons.forEach((btn) => {
            btn.addEventListener('click', () => {
                const idxAttr = btn.getAttribute('data-chapter-index');
                const idx = idxAttr ? parseInt(idxAttr, 10) : 0;
                scrollToChapter(idx);
            });
        });

        // Keyboard arrow navigation
        window.addEventListener('keydown', (e: KeyboardEvent) => {
            if (!isPanoramaActive()) return;

            // Only navigate if not typing in an input
            const target = e.target;
            if (target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement) return;

            const rect = root.getBoundingClientRect();
            const maxScroll = root.offsetHeight - window.innerHeight;
            const progress = maxScroll > 0 ? Math.max(0, Math.min(1, -rect.top / maxScroll)) : 0;
            const currentIdx = Math.round(progress * (chapters.length - 1));

            if (e.key === 'ArrowRight' || e.key === 'PageDown') {
                const nextIdx = Math.min(chapters.length - 1, currentIdx + 1);
                scrollToChapter(nextIdx);
            } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
                const prevIdx = Math.max(0, currentIdx - 1);
                scrollToChapter(prevIdx);
            }
        });

        // Support trackpad horizontal swipe gestures naturally
        viewport.addEventListener('wheel', (e: WheelEvent) => {
            if (!isPanoramaActive()) return;
            if (Math.abs(e.deltaX) > Math.abs(e.deltaY) && Math.abs(e.deltaX) > 10) {
                window.scrollBy({ top: e.deltaX, behavior: 'auto' });
            }
        }, { passive: true });

        // Tab focus auto-scroll to focused chapter
        chapters.forEach((chapter, idx) => {
            chapter.addEventListener('focusin', () => {
                if (isPanoramaActive()) {
                    scrollToChapter(idx);
                }
            });
        });

        // Window resize and motion listeners
        window.addEventListener('resize', () => {
            calculateDimensions();
            updateScroll();
        }, { passive: true });

        window.addEventListener('scroll', onScroll, { passive: true });

        prefersReducedMotion.addEventListener('change', () => {
            calculateDimensions();
            updateScroll();
        });

        // Initial setup
        calculateDimensions();
        updateScroll();
        preloadAllFrames();
    }

    function init(): void {
        const root = document.getElementById('editorial-panorama-root');
        const viewport = document.getElementById('panorama-viewport');
        const canvas = document.getElementById('panorama-canvas');

        if (!root || !viewport || !canvas) {
            return;
        }

        initEditorialPanorama(root, viewport, canvas);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
</script>

