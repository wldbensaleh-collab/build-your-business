---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
    return data.draft !== true;
});

const curatedSlugs = [
    'how-to-find-a-business-idea',
    'how-to-start-a-business-with-no-money',
    'how-to-validate-a-business-idea'
];

const curatedPosts = curatedSlugs.map(slug => allPosts.find(post => post.id === slug)).filter(Boolean);

const learningSteps = [
    { number: '01', label: 'FIND AN IDEA' },
    { number: '02', label: 'START LEAN' },
    { number: '03', label: 'VALIDATE IT' }
];
---

<Layout title="Build Your Business | Start Lean, Grow Smart" description="Practical guidance on building, managing, and growing a business using strategy, systems, technology, and practical execution.">
    <div class="homepage">
        
        <!-- 1. HERO SECTION -->
        <section class="hero">
            <div class="hero-bg-glow"></div>
            <div class="container hero-container reveal">
                <!-- LEFT COLUMN: Text -->
                <div class="hero-content">
                    <span class="eyebrow">The Entrepreneur's Playbook</span>
                    <h1>Build smarter<br/><span class="text-gradient">Start lean</span><br/>Grow a real business</h1>
                    <p class="subtitle">
                        Cut through the noise. Get practical guidance on building, managing, and growing a profitable business through systems, execution, and strategy.
                    </p>
                    <div class="cta-group">
                        <a href="/blog" class="btn btn-primary">Start Here</a>
                        <a href="/guides" class="btn btn-outline">Explore Articles</a>
                    </div>
                </div>
                
                <!-- RIGHT COLUMN: Visual System -->
                <div class="hero-visual">
                    <div class="system-card">
                        <div class="system-header">
                            <span class="system-label">THE BUSINESS SYSTEM</span>
                        </div>
                        <div class="system-steps">
                            <div class="step-item">
                                <div class="step-icon">1</div>
                                <div class="step-text">IDEA</div>
                            </div>
                            <div class="step-connector"></div>
                            <div class="step-item">
                                <div class="step-icon">2</div>
                                <div class="step-text">VALIDATE</div>
                            </div>
                            <div class="step-connector"></div>
                            <div class="step-item active-step">
                                <div class="step-icon">3</div>
                                <div class="step-text">BUILD</div>
                            </div>
                            <div class="step-connector"></div>
                            <div class="step-item">
                                <div class="step-icon">4</div>
                                <div class="step-text">SELL</div>
                            </div>
                            <div class="step-connector"></div>
                            <div class="step-item">
                                <div class="step-icon">5</div>
                                <div class="step-text">GROW</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Abstract decorative elements -->
            <div class="decoration dec-1"></div>
            <div class="decoration dec-2"></div>
        </section>

        <!-- 2. WHAT YOU'LL FIND -->
        <section class="features bg-alt">
            <div class="container">
                <div class="features-header text-center reveal">
                    <h2 class="section-title">Everything you need to build a real business</h2>
                    <p class="section-desc">
                        From understanding how businesses work to building, managing, and growing one.
                    </p>
                </div>
                <div class="pillars-grid">
                    <div class="card pillar-card reveal">
                        <div class="pillar-header">
                            <div class="pillar-number">01</div>
                            <div class="card-icon">
                                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
                            </div>
                        </div>
                        <h3>Business Fundamentals</h3>
                        <p>Understand how businesses make money, choose business models, price offers, and build solid foundations.</p>
                        <div class="pillar-footer">
                            <span class="pillar-arrow">&rarr;</span>
                        </div>
                    </div>
                    <div class="card pillar-card reveal" style="transition-delay: 100ms;">
                        <div class="pillar-header">
                            <div class="pillar-number">02</div>
                            <div class="card-icon">
                                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 16 16 12 12 8"></polyline><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                            </div>
                        </div>
                        <h3>Starting a Business</h3>
                        <p>Go from a business idea to validation, your first offer, and your first customer.</p>
                        <div class="pillar-footer">
                            <span class="pillar-arrow">&rarr;</span>
                        </div>
                    </div>
                    <div class="card pillar-card reveal" style="transition-delay: 200ms;">
                        <div class="pillar-header">
                            <div class="pillar-number">03</div>
                            <div class="card-icon">
                                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
                            </div>
                        </div>
                        <h3>Making Money</h3>
                        <p>Learn practical ways to earn through services, skills, pricing, and sustainable revenue streams.</p>
                        <div class="pillar-footer">
                            <span class="pillar-arrow">&rarr;</span>
                        </div>
                    </div>
                    <div class="card pillar-card reveal" style="transition-delay: 300ms;">
                        <div class="pillar-header">
                            <div class="pillar-number">04</div>
                            <div class="card-icon">
                                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                            </div>
                        </div>
                        <h3>Business Management & Systems</h3>
                        <p>Build better processes, systems, automation, ERP workflows, and measurable operations.</p>
                        <div class="pillar-footer">
                            <span class="pillar-arrow">&rarr;</span>
                        </div>
                    </div>
                    <div class="card pillar-card pillar-featured reveal" style="transition-delay: 400ms;">
                        <div class="pillar-header">
                            <div class="pillar-number">05</div>
                            <div class="card-icon">
                                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                            </div>
                        </div>
                        <div class="featured-content">
                            <h3>Growing a Business</h3>
                            <p>Learn marketing, sales, customer acquisition, retention, and sustainable scaling.</p>
                        </div>
                        <div class="pillar-footer">
                            <span class="pillar-arrow">&rarr;</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. FEATURED LEARNING PATH -->
        <section class="learning-path">
            <div class="container">
                <div class="text-center reveal">
                    <h2 class="section-title">Start Building Your Business</h2>
                    <p class="section-desc">
                        Practical guides to help you go from an idea to a business you can actually test.
                    </p>
                </div>
                
                <div class="path-grid">
                    {curatedPosts.map((post, index) => (
                        <article class="card path-card reveal" style={`transition-delay: ${index * 100}ms`}>
                            <div class="path-header">
                                <span class="path-num">{learningSteps[index].number}</span>
                                <span class="path-label">&mdash; {learningSteps[index].label}</span>
                            </div>
                            <div class="card-content">
                                <span class="category-badge">{post.data.category}</span>
                                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                                <p class="description">{post.data.description}</p>
                            </div>
                            <div class="card-footer">
                                <a href={`/blog/${post.id}`} class="read-more-text">Read Article &rarr;</a>
                            </div>
                        </article>
                    ))}
                </div>
                
                <div class="text-center" style="margin-top: 3rem;">
                    <a href="/blog" class="btn btn-outline">View All Articles &rarr;</a>
                </div>
            </div>
        </section>

        <!-- 4. METHODOLOGY -->
        <section class="methodology bg-alt">
            <div class="container text-center reveal">
                <h2 class="section-title">Learn. Build. Publish. Improve.</h2>
                <p class="section-desc">
                    Don't just consume business advice. Turn what you learn into something real, put it in front of people, and improve it from evidence.
                </p>
                
                <div class="cycle-container">
                    <div class="cycle-track"></div>
                    <div class="cycle-return"></div>
                    
                    <div class="cycle-steps">
                        <div class="cycle-step">
                            <div class="cycle-num">01</div>
                            <h3 class="cycle-title">Learn</h3>
                            <p class="cycle-text">Understand the problem, market, customer, and fundamentals.</p>
                        </div>
                        <div class="cycle-step">
                            <div class="cycle-num">02</div>
                            <h3 class="cycle-title">Build</h3>
                            <p class="cycle-text">Turn the knowledge into something real and testable.</p>
                        </div>
                        <div class="cycle-step">
                            <div class="cycle-num">03</div>
                            <h3 class="cycle-title">Publish</h3>
                            <p class="cycle-text">Put the work in front of real people and get feedback.</p>
                        </div>
                        <div class="cycle-step">
                            <div class="cycle-num">04</div>
                            <h3 class="cycle-title">Improve</h3>
                            <p class="cycle-text">Use results and feedback to make the business better.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. FINAL CTA -->
        <section class="final-cta">
            <div class="container text-center reveal">
                <h2>Ready to Start Building?</h2>
                <p class="section-desc">
                    Join thousands of entrepreneurs learning how to build better businesses.
                </p>
                <a href="/blog" class="btn btn-accent">Start Exploring</a>
            </div>
        </section>
    </div>
</Layout>

<script>
    // Scroll reveal logic
    document.addEventListener("DOMContentLoaded", () => {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, { threshold: 0.1 });
        
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
</script>

<style>
    /* Scope styles for the homepage */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 var(--space-3);
    }
    
    .text-center {
        text-align: center;
    }

    section {
        padding: var(--space-12) 0;
        position: relative;
        overflow: hidden;
    }
    
    .bg-alt {
        background-color: var(--color-bg-alt);
        border-top: 1px solid var(--color-border);
        border-bottom: 1px solid var(--color-border);
    }

    .section-title {
        font-size: clamp(2rem, 4vw, 2.5rem);
        margin-top: 0;
        margin-bottom: var(--space-3);
    }
    
    .section-desc {
        font-size: 1.125rem;
        color: var(--color-text-muted);
        max-width: 650px;
        margin: 0 auto var(--space-4);
        line-height: 1.7;
    }

    /* Hero Section */
    .hero {
        padding: var(--space-12) 0 var(--space-8);
        text-align: left;
        background: linear-gradient(135deg, rgba(0, 31, 63, 0.03) 0%, rgba(37, 99, 235, 0.05) 50%, rgba(139, 92, 246, 0.08) 100%);
        position: relative;
    }
    
    .hero-container {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: var(--space-8);
        align-items: center;
    }

    .hero-content {
        max-width: 600px;
    }
    
    .hero-bg-glow {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        width: 800px;
        height: 400px;
        background: radial-gradient(circle, rgba(37,99,235,0.15) 0%, rgba(255,255,255,0) 70%);
        z-index: -1;
    }
    
    .decoration {
        position: absolute;
        border-radius: 50%;
        filter: blur(40px);
        z-index: -2;
        opacity: 0.5;
    }
    
    .dec-1 {
        width: 300px;
        height: 300px;
        background: rgba(139, 92, 246, 0.2);
        top: -100px;
        right: -100px;
        animation: float 10s ease-in-out infinite;
    }
    
    .dec-2 {
        width: 250px;
        height: 250px;
        background: rgba(37, 99, 235, 0.2);
        bottom: 50px;
        left: -50px;
        animation: float 12s ease-in-out infinite reverse;
    }
    
    @keyframes float {
        0% { transform: translateY(0) scale(1); }
        50% { transform: translateY(-20px) scale(1.05); }
        100% { transform: translateY(0) scale(1); }
    }
    
    .eyebrow {
        display: inline-block;
        font-size: 0.875rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        color: var(--color-brand-accent);
        text-transform: uppercase;
        margin-bottom: var(--space-3);
        background: rgba(37, 99, 235, 0.1);
        padding: 6px 12px;
        border-radius: 20px;
    }
    
    .hero h1 {
        margin-bottom: var(--space-4);
        margin-left: 0;
        margin-right: 0;
        font-size: clamp(2.5rem, 4vw, 4rem);
        line-height: 1.1;
    }
    
    .text-gradient {
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .hero .subtitle {
        font-size: 1.125rem;
        color: var(--color-text-muted);
        margin: 0 0 var(--space-6) 0;
        max-width: 500px;
        line-height: 1.6;
    }
    
    .cta-group {
        display: flex;
        gap: var(--space-3);
        justify-content: flex-start;
        flex-wrap: wrap;
    }

    /* Hero Visual Card */
    .hero-visual {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .system-card {
        background: #ffffff;
        border: 1px solid rgba(0, 31, 63, 0.08);
        border-radius: 16px;
        padding: 2rem;
        width: 100%;
        max-width: 400px;
        box-shadow: 0 20px 40px -15px rgba(0, 116, 217, 0.15), 0 0 20px rgba(139, 92, 246, 0.05);
        position: relative;
        overflow: hidden;
    }

    .system-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; height: 4px;
        background: linear-gradient(90deg, #0074D9, #8B5CF6);
    }

    .system-header {
        text-align: center;
        margin-bottom: 2rem;
    }

    .system-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: #001F3F;
        background: rgba(0, 31, 63, 0.05);
        padding: 4px 12px;
        border-radius: 20px;
    }

    .system-steps {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .step-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 8px;
        background: transparent;
        transition: all 0.3s ease;
    }

    .step-item:hover, .step-item.active-step {
        background: rgba(0, 116, 217, 0.05);
        transform: translateX(5px);
    }

    .step-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #001F3F;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.875rem;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(0, 31, 63, 0.2);
    }

    .step-item.active-step .step-icon {
        background: #0074D9;
        box-shadow: 0 4px 12px rgba(0, 116, 217, 0.3);
    }

    .step-text {
        font-weight: 700;
        color: #001F3F;
        letter-spacing: 0.05em;
    }

    .step-connector {
        width: 2px;
        height: 16px;
        background: rgba(0, 31, 63, 0.1);
        margin-left: 31px;
    }

    /* Grid & Cards */
    .features-header {
        margin-bottom: var(--space-8);
    }
    
    .pillars-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-6);
        max-width: 1000px;
        margin: 0 auto;
    }
    
    .pillar-card {
        background: #ffffff;
        border: 1px solid rgba(0, 31, 63, 0.08);
        border-radius: 16px;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        text-align: left;
        box-shadow: 0 4px 15px rgba(0, 31, 63, 0.03);
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
        position: relative;
    }
    
    .pillar-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 116, 217, 0.1);
        border-top-color: var(--color-brand-accent);
    }

    .pillar-card:nth-child(1) { border-top: 3px solid var(--color-brand-primary); }
    .pillar-card:nth-child(2) { border-top: 3px solid var(--color-brand-accent); }
    .pillar-card:nth-child(3) { border-top: 3px solid var(--color-success); }
    .pillar-card:nth-child(4) { border-top: 3px solid var(--color-brand-purple); }
    .pillar-card:nth-child(5) { border-top: 3px solid var(--color-warning); }

    .pillar-featured {
        grid-column: 1 / -1;
        flex-direction: row;
        align-items: flex-start;
    }

    .pillar-featured .featured-content {
        flex: 1;
        margin-left: var(--space-6);
        margin-right: var(--space-6);
    }
    
    .pillar-featured .pillar-header {
        margin-bottom: 0;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .pillar-featured .pillar-footer {
        align-self: center;
    }
    
    .pillar-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: var(--space-4);
    }
    
    .pillar-number {
        font-family: monospace;
        font-size: 0.875rem;
        font-weight: 700;
        color: var(--color-brand-accent);
        background: rgba(37, 99, 235, 0.05);
        padding: 4px 8px;
        border-radius: 4px;
    }

    .card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        border-radius: var(--radius-md);
        background: rgba(0, 31, 63, 0.03);
        color: #001F3F;
    }
    
    .pillar-card h3 {
        margin-bottom: var(--space-2);
        font-size: 1.25rem;
        color: #001F3F;
    }
    
    .pillar-card p {
        color: var(--color-text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
        flex-grow: 1;
        margin-bottom: var(--space-4);
    }
    
    .pillar-footer {
        display: flex;
        justify-content: flex-end;
    }
    
    .pillar-arrow {
        color: #0074D9;
        font-weight: bold;
        transition: transform 0.3s ease;
    }
    
    .pillar-card:hover .pillar-arrow {
        transform: translateX(5px);
    }

    /* Final CTA */
    .final-cta {
        background: var(--color-brand-primary);
        color: #fff;
    }
    
    .final-cta h2 {
        color: #fff;
    }
    
    .final-cta .section-desc {
        color: var(--color-text-light);
    }
    
    /* Learning Path / Featured Content */
    .path-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: var(--space-6);
        margin-top: var(--space-8);
        text-align: left;
    }
    
    .path-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 0;
        overflow: hidden;
        border-top: 3px solid transparent;
        transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }
    
    .path-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 31, 63, 0.08);
        border-top-color: var(--color-brand-accent);
    }
    
    .path-card:nth-child(1) { border-top-color: var(--color-brand-primary); }
    .path-card:nth-child(2) { border-top-color: var(--color-brand-accent); }
    .path-card:nth-child(3) { border-top-color: var(--color-brand-purple); }
    
    .path-header {
        padding: var(--space-4) var(--space-4) 0;
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: var(--space-2);
    }
    
    .path-num {
        font-family: var(--font-mono);
        font-weight: 800;
        font-size: 1.125rem;
        color: var(--color-brand-accent);
    }
    
    .path-label {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
    }
    
    .card-content {
        padding: 0 var(--space-4);
        flex-grow: 1;
    }
    
    .category-badge {
        display: inline-block;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-brand-purple);
        background: rgba(139, 92, 246, 0.1);
        padding: 4px 10px;
        border-radius: 20px;
        margin-bottom: var(--space-3);
    }
    
    .path-card h3 {
        font-size: 1.25rem;
        margin-bottom: var(--space-2);
        line-height: 1.3;
    }
    
    .path-card h3 a {
        color: var(--color-brand-primary);
    }
    
    .path-card h3 a:hover {
        color: var(--color-brand-accent);
    }
    
    .path-card h3 a::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 1;
    }
    
    .description {
        font-size: 1rem;
        color: var(--color-text-muted);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .card-footer {
        padding: var(--space-4);
        margin-top: auto;
    }
    
    .read-more-text {
        font-weight: 600;
        color: var(--color-brand-accent);
        font-size: 0.875rem;
        position: relative;
        z-index: 2;
        transition: transform 0.3s ease, color 0.3s ease;
