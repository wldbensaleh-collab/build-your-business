        color: inherit;
        box-shadow: 0 2px 10px rgba(0, 31, 63, 0.03);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .pillar-card:hover,
    .pillar-card:focus-visible {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px rgba(0, 31, 63, 0.07);
        border-color: rgba(0, 31, 63, 0.16);
    }

    .pillar-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-3);
        height: 36px;
    }

    .pillar-card-meta {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pillar-num {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--pillar-accent, var(--color-brand-accent));
        background: rgba(0, 31, 63, 0.04);
        padding: 2px 7px;
        border-radius: 4px;
    }

    .pillar-tag {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--color-text-muted);
    }

    .pillar-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 6px;
        background: rgba(0, 31, 63, 0.03);
        color: var(--pillar-accent, var(--color-brand-primary));
    }

    .pillar-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--color-brand-primary);
        line-height: 1.3;
        margin: 0 0 var(--space-2) 0;
        min-height: 2.6em;
        display: flex;
        align-items: flex-start;
    }

    .pillar-desc {
        color: var(--color-text-muted);
        font-size: 0.875rem;
        line-height: 1.55;
        margin: 0 0 var(--space-3) 0;
        flex: 1 1 auto;
    }

    .pillar-outcome {
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--color-bg-alt);
        border: 1px solid rgba(0, 31, 63, 0.05);
        border-radius: 6px;
        padding: 6px 10px;
        margin-bottom: var(--space-3);
    }

    .outcome-label {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        font-weight: 800;
        color: var(--pillar-accent, var(--color-brand-accent));
        letter-spacing: 0.04em;
    }

    .outcome-val {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-brand-primary);
    }

    .pillar-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--space-2);
        border-top: 1px solid rgba(0, 31, 63, 0.05);
        margin-top: auto;
    }

    .pillar-link-text {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--pillar-accent, var(--color-brand-accent));
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .pillar-arrow {
        color: var(--pillar-accent, var(--color-brand-accent));
        font-weight: bold;
        transition: transform 0.2s ease;
    }

    .pillar-card:hover .pillar-arrow {
        transform: translateX(4px);
    }

    /* ========================================================================= */
    /* CHAPTER 3: GUIDED ROADMAPS (STRUCTURED DOSSIER)                           */
    /* ========================================================================= */
    .chapter-guides {
        background-color: transparent;
    }

    .guides-layout {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-8);
    }

    .chapter-header-box {
        max-width: 360px;
        flex-shrink: 0;
    }

    .guides-direct-link {
        margin-top: var(--space-4);
    }

    .guides-dossier-track {
        display: flex;
        flex-direction: row;
        gap: var(--space-4);
        flex: 1;
        justify-content: flex-end;
    }

    .guide-dossier-card {
        width: 270px;
        min-height: 350px;
        flex-shrink: 0;
        background: #ffffff;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 2px 10px rgba(0, 31, 63, 0.03);
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

    .guide-dossier-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px rgba(0, 31, 63, 0.07);
        border-color: var(--color-brand-accent);
    }

    .dossier-step-header {
        padding: var(--space-3) var(--space-4);
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--color-editorial-bg);
        border-bottom: 1px solid var(--color-border);
    }

    .dossier-num {
        font-family: var(--font-mono);
        font-weight: 800;
        font-size: 1rem;
        color: var(--color-brand-accent);
    }

    .dossier-phase {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--color-text-muted);
    }

    .dossier-body {
        padding: var(--space-4);
        flex-grow: 1;
    }

    .category-badge {
        display: inline-block;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-brand-purple);
        background: rgba(139, 92, 246, 0.08);
        padding: 2px 8px;
        border-radius: 12px;
        margin-bottom: var(--space-2);
    }

    .dossier-title {
        font-size: 1.15rem;
        margin-top: 0;
        margin-bottom: var(--space-2);
        line-height: 1.35;
    }

    .dossier-title a {
        color: var(--color-brand-primary);
        text-decoration: none;
    }

    .dossier-title a:hover {
        color: var(--color-brand-accent);
    }

    .dossier-description {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.55;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .dossier-footer {
        padding: var(--space-3) var(--space-4);
        border-top: 1px solid var(--color-border);
        background: #ffffff;
    }

    .dossier-action-link {
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--color-brand-accent);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: transform 0.2s ease;
    }

    .dossier-action-link:hover {
        transform: translateX(4px);
    }

    /* ========================================================================= */
    /* CHAPTER 4: METHODOLOGY CYCLE (RHYTHM SPREAD)                              */
    /* ========================================================================= */
    .chapter-methodology {
        background-color: transparent;
    }

    .methodology-layout {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .methodology-track-wrapper {
        position: relative;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
    }

    .methodology-connecting-line {
        position: absolute;
        top: 36px;
        left: 60px;
        right: 60px;
        height: 2px;
        background: linear-gradient(90deg, transparent, rgba(37, 99, 235, 0.3), transparent);
        z-index: 1;
    }

    .methodology-nodes-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-4);
        position: relative;
        z-index: 2;
        width: 100%;
    }

    .methodology-node-card {
        background: #ffffff;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        padding: 1.5rem;
        box-shadow: 0 2px 10px rgba(0, 31, 63, 0.03);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
    }

    .methodology-node-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px rgba(0, 31, 63, 0.07);
        border-color: var(--color-brand-accent);
    }

    .node-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-3);
    }

    .node-num {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--color-bg-alt);
        border: 2px solid var(--color-brand-primary);
        color: var(--color-brand-primary);
        font-family: var(--font-mono);
        font-weight: 800;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .methodology-node-card:hover .node-num {
        background: var(--color-brand-accent);
        border-color: var(--color-brand-accent);
        color: #ffffff;
    }

    .node-tag {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--color-brand-accent);
        background: rgba(37, 99, 235, 0.06);
        padding: 2px 6px;
        border-radius: 4px;
    }

    .node-title {
        font-size: 1.25rem;
        margin-top: 0;
        margin-bottom: var(--space-2);
        color: var(--color-brand-primary);
    }

    .node-desc {
        font-size: 0.875rem;
        color: var(--color-text-muted);
        line-height: 1.55;
        margin: 0;
    }

    .cycle-return-banner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 8px 16px;
        border: 1px dashed rgba(37, 99, 235, 0.3);
        border-radius: 20px;
        background: rgba(37, 99, 235, 0.04);
        color: var(--color-brand-accent);
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 700;
        margin-top: var(--space-2);
    }

    .return-icon {
        font-size: 1rem;
    }

    /* ========================================================================= */
    /* CHAPTER 5: THE LAUNCHPAD (EDGE-TO-EDGE CANVAS)                            */
    /* ========================================================================= */
    .chapter-cta {
        background: transparent;
        color: #0B1120;
        border-right: none;
    }

    .cta-layout {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .cta-inner-card {
        max-width: 640px;
        text-align: center;
        padding: 2.5rem 1.5rem;
    }

    .cta-main-title {
        font-size: clamp(2.2rem, 3.8vw, 3.6rem);
        font-weight: 800;
        line-height: 1.12;
        letter-spacing: -0.03em;
        color: #ffffff;
        margin-top: 0;
        margin-bottom: var(--space-4);
    }

    .cta-main-desc {
        font-size: 1.1rem;
        color: var(--color-text-light);
        line-height: 1.65;
        margin: 0 auto var(--space-6) auto;
        max-width: 500px;
    }

    .cta-action-wrap {
        display: flex;
        justify-content: center;
        gap: var(--space-4);
        margin-bottom: var(--space-6);
        flex-wrap: wrap;
    }

    .btn-large {
        padding: 13px 30px;
        font-size: 1rem;
        font-weight: 700;
    }

    .btn-dark-outline {
        background: transparent;
        color: #ffffff;
        border: 2px solid rgba(255, 255, 255, 0.25);
        border-radius: var(--radius-md);
        padding: 13px 26px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.25s ease;
    }

    .btn-dark-outline:hover {
        background: rgba(255, 255, 255, 0.1);
        border-color: #ffffff;
    }

    .cta-directory {
        border-top: 1px solid rgba(255, 255, 255, 0.12);
        padding-top: var(--space-4);
    }

    .directory-title {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        color: rgba(255, 255, 255, 0.4);
        margin-bottom: var(--space-2);
    }

    .directory-links {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: var(--space-3);
        flex-wrap: wrap;
    }

    .directory-links a {
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: color 0.2s ease;
    }

    .directory-links a:hover {
        color: #ffffff;
    }

    .dir-dot {
        color: rgba(255, 255, 255, 0.25);
    }

    /* ========================================================================= */
    /* FLOATING EDITORIAL TIMELINE DOCK (DESKTOP)                                */
    /* ========================================================================= */
    .editorial-dock {
        position: fixed;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 90;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(14px);
        border: 1px solid rgba(0, 31, 63, 0.1);
        border-radius: 36px;
        padding: 6px 14px;
        box-shadow: 0 10px 30px rgba(0, 31, 63, 0.08), 0 1px 3px rgba(0, 0, 0, 0.05);
        max-width: 90vw;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .editorial-dock.dock-hidden {
        opacity: 0;
        transform: translate(-50%, 25px);
        pointer-events: none;
    }

    .dock-container {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .dock-progress-rail {
        height: 2px;
        width: 100%;
        background: rgba(0, 31, 63, 0.08);
        border-radius: 2px;
        overflow: hidden;
    }

    .dock-progress-indicator {
        height: 100%;
        width: 0%;
        background: var(--gradient-accent);
        border-radius: 2px;
        transition: width 0.1s linear;
    }

    .dock-chapters-list {
        display: flex;
        align-items: center;
        list-style: none;
        padding: 0;
        margin: 0;
        gap: 4px;
    }

    .dock-chapter-btn {
        background: transparent;
        border: none;
        border-radius: 20px;
        padding: 6px 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: all 0.25s ease;
        outline: none;
        color: var(--color-text-muted);
    }

    .dock-chapter-btn:hover {
        background: rgba(37, 99, 235, 0.06);
        color: var(--color-brand-accent);
    }

    .dock-chapter-btn.active {
        background: var(--color-brand-primary);
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(11, 17, 32, 0.2);
    }

    .dock-chap-num {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        font-weight: 800;
        opacity: 0.8;
    }

    .dock-chapter-btn.active .dock-chap-num {
        color: #60A5FA;
    }

    .dock-chap-label {
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.02em;
    }

    /* ========================================================================= */
    /* RESPONSIVE LAYOUT MODES: DESKTOP PANORAMA VS MOBILE VERTICAL EDITORIAL    */
    /* ========================================================================= */

    /* Desktop Panorama Mode (>= 768px) */
    @media (min-width: 768px) {
        /* Fixed Header eliminates any initial vertical document movement */
        :global(body:has(#editorial-panorama-root) .site-header) {
            position: fixed !important;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;
            z-index: 100;
            background-color: rgba(255, 255, 255, 0.92) !important;
            backdrop-filter: blur(14px) !important;
            border-bottom: 1px solid rgba(0, 31, 63, 0.06) !important;
        }

        .panorama-viewport {
            position: sticky;
            top: 0;
            height: 100vh;
            width: 100%;
            overflow: hidden;
            container-type: inline-size;
        }

        .panorama-canvas {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: row;
            height: 100%;
            width: max-content;
            will-change: transform;
        }

        /* Every chapter occupies exactly one viewport width */
        .chapter {
            width: var(--chapter-width, 100cqw);
            min-width: var(--chapter-width, 100cqw);
            max-width: var(--chapter-width, 100cqw);
            flex-basis: var(--chapter-width, 100cqw);
            flex-shrink: 0;
            height: 100vh;
            padding: 80px 2.5rem 40px;
            box-sizing: border-box;
            background: transparent;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* ------------------------------------------------------------- */
        /* Chapter 01: Hero (Midnight Navy Atmosphere)                   */
        /* ------------------------------------------------------------- */
        .chapter-hero {
            background: transparent;
        }

        .chapter-hero .hero-title {
            color: #FFFFFF;
        }

        .chapter-hero .text-gradient {
            background: linear-gradient(135deg, #60A5FA 0%, #C084FC 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .chapter-hero .hero-desc {
            color: #94A3B8;
        }

        .chapter-hero .chapter-badge {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.16);
        }

        .chapter-hero .badge-index {
            color: #60A5FA;
        }

        .chapter-hero .badge-text {
            color: #F8FAFC;
        }

        .chapter-hero .btn-primary {
            background: #2563EB;
            color: #FFFFFF;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        }

        .chapter-hero .btn-primary:hover {
            background: #1D4ED8;
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
        }

        .chapter-hero .btn-outline {
            border: 1.5px solid rgba(255, 255, 255, 0.3);
            color: #FFFFFF;
        }

        .chapter-hero .btn-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #FFFFFF;
        }

        .chapter-hero .hero-scroll-hint {
            color: #60A5FA;
        }

        .chapter-hero .hero-sculpture-stage {
            background: radial-gradient(
                circle at 50% 50%,
                rgba(37, 99, 235, 0.14) 0%,
                rgba(37, 99, 235, 0.03) 50%,
                transparent 70%
            );
        }

        /* ------------------------------------------------------------- */
        /* Chapter 02: Pillars (Deep Cobalt Atmosphere)                  */
        /* ------------------------------------------------------------- */
        .chapter-pillars {
            background: transparent;
        }

        .chapter-pillars .chapter-heading {
            color: #FFFFFF;
        }

        .chapter-pillars .chapter-summary {
            color: #94A3B8;
        }

        .chapter-pillars .chapter-badge {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.16);
        }

        .chapter-pillars .badge-index {
            color: #60A5FA;
        }

        .chapter-pillars .badge-text {
            color: #F8FAFC;
        }

        .chapter-pillars .pillar-card {
            background: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
        }

        .chapter-pillars .pillar-card:hover,
        .chapter-pillars .pillar-card:focus-visible {
            transform: translateY(-4px);
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.32);
            border-color: rgba(255, 255, 255, 0.3);
        }

        /* ------------------------------------------------------------- */
        /* Chapter 03: Guided Roadmaps (Muted Blue Atmosphere)           */
        /* ------------------------------------------------------------- */
        .chapter-guides {
            background: transparent;
        }

        .chapter-guides .chapter-heading {
            color: #FFFFFF;
        }

        .chapter-guides .chapter-summary {
            color: #CBD5E1;
        }

        .chapter-guides .chapter-badge {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.18);
        }

        .chapter-guides .badge-index {
            color: #93C5FD;
        }

        .chapter-guides .badge-text {
            color: #FFFFFF;
        }

        .chapter-guides .guides-direct-link .btn-outline {
            border: 1.5px solid rgba(255, 255, 255, 0.35);
            color: #FFFFFF;
        }

        .chapter-guides .guides-direct-link .btn-outline:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: #FFFFFF;
        }

        .chapter-guides .guide-dossier-card {
            background: #FFFFFF;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
        }

        /* ------------------------------------------------------------- */
        /* Chapter 04: Execution Methodology (Pale Blue Atmosphere)      */
        /* ------------------------------------------------------------- */
        .chapter-methodology {
            background: transparent;
            border-right: 1px solid rgba(0, 31, 63, 0.08);
        }

        .chapter-methodology .chapter-heading {
            color: #0B1120;
        }

        .chapter-methodology .chapter-summary {
            color: #475569;
        }

        .chapter-methodology .chapter-badge {
            background: rgba(37, 99, 235, 0.08);
            border-color: rgba(37, 99, 235, 0.2);
        }

        .chapter-methodology .badge-index {
            color: #2563EB;
        }

        .chapter-methodology .badge-text {
            color: #0B1120;
        }

        .chapter-methodology .methodology-node-card {
            background: #FFFFFF;
            border: 1px solid rgba(37, 99, 235, 0.14);
            box-shadow: 0 8px 24px rgba(16, 29, 54, 0.06);
        }

        .chapter-methodology .cycle-return-banner {
            background: rgba(255, 255, 255, 0.85);
            border-color: rgba(37, 99, 235, 0.35);
            color: #1D4ED8;
        }

        /* ------------------------------------------------------------- */
        /* Chapter 05: Destination Launchpad (Editorial Cream Atmosphere)*/
        /* ------------------------------------------------------------- */
        .chapter-cta {
            background: transparent;
            border-right: none;
        }

        .chapter-cta .chapter-badge {
            background: rgba(11, 17, 32, 0.06);
            border: 1px solid rgba(11, 17, 32, 0.14);
        }

        .chapter-cta .badge-index {
            color: #2563EB;
        }

        .chapter-cta .badge-text {
            color: #0B1120;
        }

        .chapter-cta .cta-main-title {
            color: #0B1120;
        }

        .chapter-cta .cta-main-desc {
            color: #475569;
        }

        .chapter-cta .btn-dark-outline {
            background: transparent;
            color: #0B1120;
            border: 2px solid #0B1120;
        }

        .chapter-cta .btn-dark-outline:hover {
            background: rgba(11, 17, 32, 0.06);
            border-color: #0B1120;
        }

        .chapter-cta .cta-directory {
