---
---
<header class="site-header">
    <div class="container">
        <a href="/" class="logo">Build Your Business</a>
        <nav aria-label="Main Navigation">
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/blog">Blog</a></li>
                <li><a href="/guides">Guides</a></li>
                <li><a href="/resources">Resources</a></li>
                <li><a href="/about">About</a></li>
            </ul>
        </nav>
    </div>
</header>

<style>
    .site-header {
        border-bottom: 1px solid #eaeaea;
        padding: 1rem 0;
        background-color: #ffffff;
    }
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }
    .logo {
        font-weight: 600;
        font-size: 1.25rem;
        color: #111827;
        text-decoration: none;
    }
    nav {
        display: flex;
    }
    .nav-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }
    .nav-links a {
        color: #4b5563;
        text-decoration: none;
        font-size: 0.95rem;
        transition: color 0.2s ease;
    }
    .nav-links a:hover {
        color: #111827;
    }
    
    @media (max-width: 768px) {
        .container {
            flex-direction: column;
            text-align: center;
        }
        .nav-links {
            justify-content: center;
        }
    }
</style>
